# Morning Briefing - 매일 아침 8시 텔레그램 알림
name: Morning Briefing

on:
  schedule:
    # 매일 한국시간 8시 (UTC 23시 전날)
    - cron: '0 23 * * *'
  workflow_dispatch:  # 수동 실행 가능

jobs:
  morning-briefing:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          pip install google-auth google-auth-oauthlib google-auth-httplib2 google-api-python-client requests

      - name: Create credentials files
        env:
          GOOGLE_TOKEN_JSON: ${{ secrets.GOOGLE_TOKEN_JSON }}
          GOOGLE_CREDENTIALS_JSON: ${{ secrets.GOOGLE_CREDENTIALS_JSON }}
        run: |
          cd projects/funding-arbitrage
          echo "$GOOGLE_TOKEN_JSON" > token.json
          echo "$GOOGLE_CREDENTIALS_JSON" > credentials.json

      - name: Create todos file (if not exists)
        run: |
          cd projects/funding-arbitrage
          if [ ! -f todos.json ]; then
            echo "[]" > todos.json
          fi

      - name: Run Morning Briefing
        env:
          TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: |
          cd projects/funding-arbitrage
          python3 morning_briefing.py
