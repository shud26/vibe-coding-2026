# Contract Addresses (update after deployment)
VITE_USDC_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# RPC URL (optional, defaults to public Base Sepolia RPC)
VITE_RPC_URL=https://sepolia.base.org

# App URL for Mini App configuration
VITE_APP_URL=https://triangle-dice-miniapp.vercel.app

# Foundry deployment (used in contracts folder)
# Create contracts/.env with these values
# PRIVATE_KEY=your_private_key_here
# FEE_COLLECTOR=your_fee_collector_address
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# BASESCAN_API_KEY=your_basescan_api_key
